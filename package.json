{
  "name": "dashcut",
  "version": "0.1.0",
  "private": true,
  "description": "DashCut (极剪), a bilingual AI video editor for Bilibili and YouTube creators",
  "author": "Mikasathebest",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/video-export.test.mjs",
    "desktop": "npm run build && electron .",
    "desktop:smoke": "node electron/smoke-test.mjs",
    "runtime:build": "node scripts/build-local-runtime.mjs",
    "media:build": "bash scripts/build-ffmpeg-runtime.sh",
    "media:verify": "node scripts/verify-ffmpeg-runtime.mjs",
    "dist:mac": "npm run runtime:build && npm run media:verify && npm run build && electron-builder --mac dmg --publish never",
    "dist:win": "npm run runtime:build && npm run media:verify && npm run build && electron-builder --win nsis --x64 --publish never",
    "release:mac": "npm run runtime:build && npm run media:verify && npm run build && electron-builder --mac dmg --publish never -c.forceCodeSigning=true",
    "release:win": "npm run runtime:build && npm run media:verify && npm run build && electron-builder --win nsis --x64 --publish never -c.forceCodeSigning=true",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "build": {
    "appId": "com.mikasathebest.dashcut",
    "productName": "DashCut",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "local-engine",
        "to": "local-engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "local-runtime",
        "to": "local-runtime",
        "filter": [
          "dashcut-transcribe/**/*"
        ]
      },
      {
        "from": "media-runtime/current",
        "to": "media-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        {
          "target": "dmg"
        }
      ]
    },
    "dmg": {
      "title": "DashCut ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DashCut 极剪"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
